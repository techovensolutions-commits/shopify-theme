<section class="lp-rail page-width">
  <div class="lp-section-heading" data-lp-reveal><div><span class="lp-eyebrow">{{ section.settings.eyebrow }}</span><h2 class="lp-title">{{ section.settings.heading }}</h2></div><a class="lp-section-link" href="{{ section.settings.all_link }}">Tout explorer</a></div>
  <div class="lp-category-grid" aria-label="{{ section.settings.heading | escape }}">
    {% for block in section.blocks %}
      {% assign fallback_product = collections.all.products[forloop.index0] %}
      <a class="lp-category-card" href="{{ block.settings.link | default: '/collections/all' }}" {{ block.shopify_attributes }} data-lp-reveal>
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(max-width: 749px) 78vw, 30vw' }}
        {% elsif fallback_product.featured_media %}
          {{ fallback_product.featured_media.preview_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(max-width: 749px) 78vw, 30vw', alt: block.settings.title }}
        {% else %}{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}{% endif %}
        <div class="lp-category-card__content"><span class="lp-category-card__number">0{{ forloop.index }}</span><h3>{{ block.settings.title }}</h3><p>{{ block.settings.description }}</p></div>
      </a>
    {% endfor %}
  </div>
</section>
{% schema %}
{"name":"LP — Catégories","max_blocks":6,"settings":[{"type":"text","id":"eyebrow","label":"Surtitre","default":"Sélection par univers"},{"type":"text","id":"heading","label":"Titre","default":"Trouve ton mouvement."},{"type":"url","id":"all_link","label":"Lien Tout explorer"}],"blocks":[{"type":"category","name":"Catégorie","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"title","label":"Titre","default":"ASICS"},{"type":"text","id":"description","label":"Description","default":"Performance culte"},{"type":"url","id":"link","label":"Lien"}]}],"presets":[{"name":"LP — Catégories","blocks":[{"type":"category"},{"type":"category","settings":{"title":"ON RUNNING","description":"Confort radical"}},{"type":"category","settings":{"title":"MIZUNO","description":"Technicité japonaise"}},{"type":"category","settings":{"title":"SALOMON","description":"Outdoor urbain"}}]}]}
{% endschema %}

<section class="lp-rail page-width">
  <div class="lp-section-heading" data-lp-reveal><div><span class="lp-eyebrow">{{ section.settings.eyebrow }}</span><h2 class="lp-title">{{ section.settings.heading }}</h2></div><a class="lp-section-link" href="{{ section.settings.all_link }}">Tout explorer</a></div>
  <div class="lp-category-grid" aria-label="{{ section.settings.heading | escape }}">
    {% for block in section.blocks %}
      {% liquid
        assign category_product = block.settings.product
        assign category_collection = block.settings.collection

        if category_product == blank and category_collection != blank
          assign category_product = category_collection.products.first
        endif

        assign category_link = block.settings.link
        if category_link == blank and category_collection != blank
          assign category_link = category_collection.url
        endif
        if category_link == blank and category_product != blank
          assign category_link = category_product.url
        endif
        if category_link == blank
          assign category_link = routes.all_products_collection_url
        endif

        assign category_image = block.settings.image
        if category_image == blank and category_product != blank
          assign category_image = category_product.featured_media.preview_image
        endif
      %}
      <a class="lp-category-card" href="{{ category_link }}" {{ block.shopify_attributes }} data-lp-reveal>
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(max-width: 749px) 78vw, 30vw' }}
        {% elsif category_image != blank %}
          {{ category_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(max-width: 749px) 78vw, 30vw', alt: block.settings.title }}
        {% else %}{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}{% endif %}
        <div class="lp-category-card__content"><span class="lp-category-card__number">0{{ forloop.index }}</span><h3>{{ block.settings.title }}</h3><p>{{ block.settings.description }}</p></div>
      </a>
    {% endfor %}
  </div>
</section>
{% schema %}
{"name":"LP — Catégories","max_blocks":6,"settings":[{"type":"text","id":"eyebrow","label":"Surtitre","default":"Sélection par univers"},{"type":"text","id":"heading","label":"Titre","default":"Trouve ton mouvement."},{"type":"url","id":"all_link","label":"Lien Tout explorer"}],"blocks":[{"type":"category","name":"Catégorie","settings":[{"type":"image_picker","id":"image","label":"Image personnalisée"},{"type":"product","id":"product","label":"Produit à afficher","info":"L’image principale de ce produit est utilisée si aucune image personnalisée n’est choisie."},{"type":"collection","id":"collection","label":"Collection associée"},{"type":"text","id":"title","label":"Titre","default":"ASICS"},{"type":"text","id":"description","label":"Description","default":"Performance culte"},{"type":"url","id":"link","label":"Lien","info":"Facultatif. La collection ou le produit associé est utilisé automatiquement."}]}],"presets":[{"name":"LP — Catégories","blocks":[{"type":"category"},{"type":"category","settings":{"title":"ON RUNNING","description":"Confort radical"}},{"type":"category","settings":{"title":"MIZUNO","description":"Technicité japonaise"}},{"type":"category","settings":{"title":"SALOMON","description":"Outdoor urbain"}}]}]}
{% endschema %}

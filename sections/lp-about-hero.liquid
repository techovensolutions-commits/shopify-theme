{% liquid
  assign fallback_product = collections.all.products.first
  assign fallback_image = fallback_product.featured_media.preview_image
%}

{% render 'lp-breadcrumbs', current_title: section.settings.breadcrumb_label, show_collections_parent: false %}

<section class="lp-about-hero">
  <div class="lp-about-hero__inner page-width">
    <div class="lp-about-hero__copy" data-lp-reveal>
      {% if section.settings.eyebrow != blank %}<span class="lp-eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
      <h1>{{ section.settings.heading }}</h1>
      {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
      {% if section.settings.button_label != blank %}<a class="lp-button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>{% endif %}
    </div>

    <div class="lp-about-hero__media" data-lp-reveal>
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '600, 900, 1200, 1600', sizes: '(max-width: 749px) 100vw, 50vw', alt: section.settings.image.alt }}
      {% elsif fallback_image != blank %}
        {{ fallback_image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '500, 800, 1100, 1400', sizes: '(max-width: 749px) 100vw, 50vw', alt: fallback_product.title }}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}
      <span class="lp-about-hero__stamp" aria-hidden="true">LP<br>MARKET</span>
    </div>

    {% if section.blocks.size > 0 %}
      <div class="lp-about-hero__stats">
        {% for block in section.blocks %}
          <div class="lp-about-hero__stat" {{ block.shopify_attributes }}>
            <strong>{{ block.settings.number }}</strong>
            <span>{{ block.settings.label }}</span>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "LP — Hero À propos",
  "settings": [
    { "type": "text", "id": "breadcrumb_label", "label": "Libellé du fil d'Ariane", "default": "À propos" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Notre vision" },
    { "type": "textarea", "id": "heading", "label": "Titre", "default": "La sneaker comme point de départ." },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "LP Market sélectionne les silhouettes qui associent caractère, confort et culture. Des paires pensées pour être portées, pas seulement regardées." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Voir le catalogue" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Chiffre clé",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "number", "label": "Chiffre", "default": "100 %" },
        { "type": "text", "id": "label", "label": "Libellé", "default": "Sélection LP" }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP — Hero À propos",
      "blocks": [
        { "type": "stat", "settings": { "number": "100 %", "label": "Sélection LP" } },
        { "type": "stat", "settings": { "number": "24/7", "label": "Boutique en ligne" } },
        { "type": "stat", "settings": { "number": "FR", "label": "Livraison suivie" } }
      ]
    }
  ]
}
{% endschema %}

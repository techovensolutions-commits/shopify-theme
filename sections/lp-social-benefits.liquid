{%- assign lp_whatsapp_url = section.settings.whatsapp_url | default: 'https://wa.me/33746415494' -%}

<section class="lp-prefooter" aria-labelledby="LPPrefooterTitle-{{ section.id }}">
  <div class="lp-prefooter__social">
    <div class="page-width">
      <h2 id="LPPrefooterTitle-{{ section.id }}">{{ section.settings.heading }}</h2>
      <div class="lp-prefooter__social-links" aria-label="Réseaux sociaux">
        {% if section.settings.tiktok_url != blank %}<a href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener" aria-label="TikTok Lp.markete" title="TikTok — @Lp.markete">
        {% else %}<span aria-label="TikTok">{% endif %}
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M15.7 3c.2 1.9 1.3 3.1 3.3 3.2v3.1c-1.2 0-2.3-.3-3.3-.9v6.1a6 6 0 1 1-5.2-5.9v3.2a2.9 2.9 0 1 0 2.1 2.7V3h3.1Z"/></svg>
        {% if section.settings.tiktok_url != blank %}</a>{% else %}</span>{% endif %}

        {% if section.settings.snapchat_url != blank %}<a href="{{ section.settings.snapchat_url }}" target="_blank" rel="noopener" aria-label="Snapchat Lp.market" title="Snapchat — Lp.market">
        {% else %}<span aria-label="Snapchat">{% endif %}
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.8c3 0 5 2.3 5 5.5 0 .8-.1 1.6-.2 2.2.4.7 1.2 1.3 2.3 1.7.6.2.8.6.7 1-.1.5-.7.8-1.8 1-.4.1-.6.2-.6.3 0 .2.3.5.6.7.5.3.4.9 0 1.1-.7.4-1.6.4-2.2.6-.3.1-.5.5-.7.9-.4.8-1.2 1.3-2.1 1.1-.6-.1-1.1-.4-1.5-.4-.5 0-1 .3-1.6.4-.9.2-1.7-.3-2.1-1.1-.2-.4-.4-.8-.7-.9-.6-.2-1.5-.2-2.2-.6-.4-.2-.5-.8 0-1.1.3-.2.6-.5.6-.7 0-.1-.2-.2-.6-.3-1.1-.2-1.7-.5-1.8-1-.1-.4.1-.8.7-1 1.1-.4 1.9-1 2.3-1.7-.1-.6-.2-1.4-.2-2.2 0-3.2 2-5.5 5-5.5Z"/></svg>
        {% if section.settings.snapchat_url != blank %}</a>{% else %}</span>{% endif %}

        {% if lp_whatsapp_url != blank %}<a href="{{ lp_whatsapp_url }}" target="_blank" rel="noopener" aria-label="WhatsApp 07 46 41 54 94" title="WhatsApp — 07 46 41 54 94">
        {% else %}<span aria-label="WhatsApp">{% endif %}
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M20 11.5a8 8 0 0 1-11.7 7.1L4 20l1.4-4.1A8 8 0 1 1 20 11.5Z" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/><path d="M8.6 7.7c.2-.4.5-.4.8-.4h.4c.2 0 .4.1.5.5l.8 1.8c.1.3.1.5-.1.7l-.6.7c-.2.2-.1.4 0 .6.7 1.2 1.7 2.1 3 2.6.3.1.5.1.7-.1l.8-1c.2-.2.4-.3.7-.2l1.8.9c.3.2.5.3.5.5 0 .2-.1 1.2-.8 1.8-.6.6-1.5.8-2.4.6-1.1-.2-2.5-.8-4.3-2.4-1.5-1.4-2.5-3-2.8-4.1-.3-1.1 0-2 .4-2.5Z" fill="currentColor"/></svg>
        {% if lp_whatsapp_url != blank %}</a>{% else %}</span>{% endif %}
      </div>
    </div>
  </div>

  <div class="lp-prefooter__benefits">
    <div class="lp-prefooter__grid page-width">
      {% for block in section.blocks %}
        <article class="lp-prefooter__item" {{ block.shopify_attributes }}>
          <div class="lp-prefooter__icon" aria-hidden="true">
            {% case block.settings.icon %}
              {% when 'payment' %}
                <svg viewBox="0 0 32 32" fill="none"><rect x="7" y="13" width="18" height="14" rx="4" stroke="currentColor" stroke-width="2"/><path d="M11 13V9a5 5 0 0 1 10 0v4M16 19v3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              {% when 'support' %}
                <svg viewBox="0 0 32 32" fill="none"><path d="M6 17v-2a10 10 0 0 1 20 0v2M6 17h4v8H8a2 2 0 0 1-2-2v-6Zm20 0h-4v8h2a2 2 0 0 0 2-2v-6ZM22 27c-1.7 1.3-3.7 2-6 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {% when 'tag' %}
                <svg viewBox="0 0 32 32" fill="none"><path d="M5 15V6h9l13 13-8 8L5 15Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><circle cx="10" cy="11" r="2" fill="currentColor"/></svg>
              {% else %}
                <svg viewBox="0 0 32 32" fill="none"><path d="m5 10 11-6 11 6v13l-11 6-11-6V10Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="m5 10 11 6 11-6M16 16v13M10 7l11 6" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
            {% endcase %}
          </div>
          <h3>{{ block.settings.title }}</h3>
          <div class="lp-prefooter__text">{{ block.settings.text | newline_to_br }}</div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LP — Réseaux et services",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Nos réseaux" },
    { "type": "url", "id": "tiktok_url", "label": "Lien TikTok" },
    { "type": "url", "id": "snapchat_url", "label": "Lien Snapchat" },
    { "type": "url", "id": "whatsapp_url", "label": "Lien WhatsApp" }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "default": "shipping",
          "options": [
            { "value": "shipping", "label": "Livraison" },
            { "value": "payment", "label": "Paiement" },
            { "value": "support", "label": "Service client" },
            { "value": "tag", "label": "Avantages" }
          ]
        },
        { "type": "text", "id": "title", "label": "Titre", "default": "Livraison" },
        { "type": "textarea", "id": "text", "label": "Texte", "default": "Expédition suivie et livraison soignée partout en France." }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP — Réseaux et services",
      "blocks": [
        { "type": "service", "settings": { "icon": "shipping", "title": "Livraison" } },
        { "type": "service", "settings": { "icon": "payment", "title": "Paiement sécurisé" } },
        { "type": "service", "settings": { "icon": "support", "title": "Service client" } },
        { "type": "service", "settings": { "icon": "tag", "title": "Avantages LP" } }
      ]
    }
  ]
}
{% endschema %}

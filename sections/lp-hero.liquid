<section class="lp-hero">
  <div class="lp-hero__media" aria-hidden="true">
    <picture>
      {% if section.settings.mobile_image != blank %}
        <source
          media="(max-width: 749px)"
          srcset="
            {{ section.settings.mobile_image | image_url: width: 480 }} 480w,
            {{ section.settings.mobile_image | image_url: width: 750 }} 750w,
            {{ section.settings.mobile_image | image_url: width: 1000 }} 1000w
          "
          sizes="100vw"
        >
      {% else %}
        <source media="(max-width: 749px)" srcset="{{ 'lp-market-hero-mobile.jpeg' | asset_url }}">
      {% endif %}

      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw' }}
      {% else %}
        <img
          src="{{ 'lp-market-hero-desktop.jpeg' | asset_url }}"
          width="1586"
          height="992"
          alt=""
          loading="eager"
          fetchpriority="high"
        >
      {% endif %}
    </picture>
  </div>
  <div class="lp-hero__overlay"></div>
  <div class="lp-hero__content page-width"><div class="lp-hero__copy" data-lp-reveal>
    <span class="lp-eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="lp-title">{{ section.settings.heading }}</h1>
    <p class="lp-hero__text">{{ section.settings.text }}</p>
    <a class="lp-button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
  </div></div>
</section>
{% schema %}
{"name":"LP — Hero éditorial","settings":[{"type":"image_picker","id":"image","label":"Image de couverture — ordinateur"},{"type":"image_picker","id":"mobile_image","label":"Image de couverture — mobile"},{"type":"text","id":"eyebrow","label":"Surtitre","default":"LP Market — Nouvelle sélection"},{"type":"textarea","id":"heading","label":"Titre","default":"La paire qui change le rythme."},{"type":"textarea","id":"text","label":"Texte","default":"Une sélection pointue de sneakers techniques, iconiques et difficiles à trouver."},{"type":"text","id":"button_label","label":"Libellé du bouton","default":"Découvrir la sélection"},{"type":"url","id":"button_link","label":"Lien du bouton"}],"presets":[{"name":"LP — Hero éditorial"}]}
{% endschema %}

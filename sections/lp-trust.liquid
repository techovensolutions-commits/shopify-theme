<section class="lp-trust"><div class="page-width"><div class="lp-section-heading" data-lp-reveal><div><span class="lp-eyebrow">{{ section.settings.eyebrow }}</span><h2 class="lp-title">{{ section.settings.heading }}</h2></div></div><div class="lp-trust__grid">{% for block in section.blocks %}<article class="lp-trust__item" {{ block.shopify_attributes }} data-lp-reveal><span>0{{ forloop.index }}</span><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></article>{% endfor %}</div></div></section>
{% schema %}
{"name":"LP — Engagements","settings":[{"type":"text","id":"eyebrow","label":"Surtitre","default":"L'expérience LP"},{"type":"text","id":"heading","label":"Titre","default":"Simple. Sûr. Désirable."}],"blocks":[{"type":"item","name":"Engagement","settings":[{"type":"text","id":"title","label":"Titre","default":"Sélection contrôlée"},{"type":"textarea","id":"text","label":"Texte","default":"Des modèles choisis pour leur silhouette, leur confort et leur présence."}]}],"presets":[{"name":"LP — Engagements","blocks":[{"type":"item","settings":{"title":"Sélection contrôlée","text":"Des modèles choisis pour leur silhouette, leur confort et leur présence."}},{"type":"item","settings":{"title":"Paiement sécurisé","text":"Un parcours d'achat clair et protégé à chaque étape."}},{"type":"item","settings":{"title":"Service à l'écoute","text":"Besoin d'un conseil taille ou modèle ? Notre équipe vous répond."}}]}]}
{% endschema %}
